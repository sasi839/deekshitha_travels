# ==============================================================================
# DEEKSHITHA TRAVELS - ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================

# Supabase Project URL (Public)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Key (Public - Browser Safe)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> anon public
# Modern keys begin with 'sb_publishable_', legacy keys begin with 'eyJhbGciOi...'
# Enforced by Row Level Security (RLS) policies.
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Supabase Secret / Service Role Key (SERVER-SIDE ONLY - NEVER prefix with VITE_)
# Strictly forbidden in browser environments! Bypasses RLS. Kept only on backend servers.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
